{
  "name": "vesper",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "tsc -b && npm run build -w @vesper/ui",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "demo": "node packages/web/dist/main.js",
    "bench": "npm run bench -w @vesper/web --",
    "stop-host": "tsx packages/web/scripts/stop-host.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.4",
    "playwright-core": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
